PORT=4000
JWT_SECRET=change-this-dev-secret
# DATABASE_URL=postgres://user:password@localhost:5432/doctor_app

# ── WhatsApp / SMS (Twilio) ───────────────────────────────────
# Without these, notifications are composed and logged but never sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Country code assumed when a patient types a local number (92 = Pakistan)
# DEFAULT_COUNTRY_CODE=92

# ── AI Colleague ──────────────────────────────────────────────
# Doctor-facing clinical second opinion. Without a key the feature shows
# as unavailable rather than failing.
# AI_PROVIDER=openai            # openai (default) | anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Reserved for the advanced subscription tier:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Questions allowed per doctor per 24h (cost guard)
# AI_DAILY_LIMIT=50
